# Copie para .env e preencha o que voce tiver. Tudo e opcional:
# sem nenhuma chave o app ja funciona com Bing RSS, DuckDuckGo, Mojeek,
# Google News RSS, Wikidata, OpenAlex e GitHub.

PORT=3000

# Brave Search API - plano gratuito 2.000 consultas/mes
# https://brave.com/search/api/
BRAVE_API_KEY=

# Google Programmable Search Engine - 100 consultas/dia gratis
# https://programmablesearchengine.google.com/  +  https://console.cloud.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Instancia SearXNG propria com formats: [json] habilitado no settings.yml
# Ex.: http://localhost:8080
SEARXNG_URL=

# Token do GitHub (opcional) - sobe o limite de 10 para 30 buscas/min
GITHUB_TOKEN=

# Portal da Transparencia - chave gratuita por cadastro de e-mail.
# Libera consulta de servidores publicos federais por nome.
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# Requisicoes por minuto por IP
RATE_LIMIT_PER_MIN=20
